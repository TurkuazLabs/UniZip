{#
# 📄 Dosya Yolu: upload/admin/view/template/extension/module/turkuaz_entitlement_api.twig
# 📌 Amac: Turkuaz Entitlement API admin ayar formunu cizmek
# 📌 Modul - FileType
# Version: 0.2.0
# Aciklama: Multi-store entitlement product map ve API ayarlari arayuzu
# Bagimli Oldugu Katman: View
#}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-turkuaz-entitlement-api" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-key"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-turkuaz-entitlement-api" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_turkuaz_entitlement_api_status" id="input-status" class="form-control">
                {% if module_turkuaz_entitlement_api_status %}
                  <option value="1" selected="selected">{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-project-map"><span data-toggle="tooltip" title="{{ help_project_map }}">{{ entry_project_map }}</span></label>
            <div class="col-sm-10">
              <textarea name="module_turkuaz_entitlement_api_project_map" id="input-project-map" rows="10" class="form-control">{{ module_turkuaz_entitlement_api_project_map }}</textarea>
              <p class="help-block">{{ help_project_map }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-order-status-ids"><span data-toggle="tooltip" title="{{ help_order_status_ids }}">{{ entry_order_status_ids }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="module_turkuaz_entitlement_api_order_status_ids" value="{{ module_turkuaz_entitlement_api_order_status_ids }}" id="input-order-status-ids" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-device-limit">{{ entry_default_device_limit }}</label>
            <div class="col-sm-10">
              <input type="number" min="1" name="module_turkuaz_entitlement_api_default_device_limit" value="{{ module_turkuaz_entitlement_api_default_device_limit }}" id="input-device-limit" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-offline-grace-days">{{ entry_offline_grace_days }}</label>
            <div class="col-sm-10">
              <input type="number" min="1" name="module_turkuaz_entitlement_api_offline_grace_days" value="{{ module_turkuaz_entitlement_api_offline_grace_days }}" id="input-offline-grace-days" class="form-control" />
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-secret"><span data-toggle="tooltip" title="{{ help_api_secret }}">{{ entry_api_secret }}</span></label>
            <div class="col-sm-10">
              <input type="text" name="module_turkuaz_entitlement_api_secret" value="{{ module_turkuaz_entitlement_api_secret }}" id="input-api-secret" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
